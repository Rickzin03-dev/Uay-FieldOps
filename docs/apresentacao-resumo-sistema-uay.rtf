\pard\qc\sb600\sa180\f1\fs42\cf2\b UAY INTERNET\par
\pard\qc\sa120\f1\fs34\cf1\b CONTROLE DE ESTOQUE\par
\pard\qc\sa300\f0\fs24\cf4 Apresentacao resumida do sistema\par
\pard\qc\brdrb\brdrs\brdrw35\brdrcf3\sa300\fs20\cf3\b ALMOXARIFADO | TECNICOS | RASTREABILIDADE\b0\par
\pard\qc\sa520\fs20\cf4 Documento para apresentacao corporativa\par
\pard\ql\sa180\f1\fs28\cf1\b Visao geral\b0\par
\pard\sa180\f0\fs20\cf4 O sistema Uay Internet foi organizado para controlar o ciclo completo do almoxarifado: cadastro, estoque, entradas, saidas, tecnicos, ativos de campo, inventario, movimentacoes e relatorios.\par
\pard\sa260\fs20\cf4 A proposta e permitir que a empresa saiba o que possui, o que entrou, o que saiu, quem recebeu cada item e qual foi o motivo da movimentacao.\par

\pard\sb260\sa140\f1\fs27\cf1\b 1. Dashboard\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Materiais cadastrados e quantidade total em estoque.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Entradas, saidas e tecnicos ativos.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Grafico de movimentacao com quantidade ao passar o cursor.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Indicadores atualizados automaticamente apos login e operacoes.\par

\pard\sb220\sa140\f1\fs27\cf1\b 2. Estoque\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Consulta por nome, codigo e grupo.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Cadastro de materiais e consulta de saldo.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Importacao de lista CSV sem apagar itens existentes.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Identificacao por codigo, patrimonio, numero de serie, barcode e QR Code.\par

\pard\sb220\sa140\f1\fs27\cf1\b 3. Materiais para tecnicos\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Roteadores, bobinas, cabo Drop e cabos de rede.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Conectores, RJ45, splitters e cordoes opticos.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Miguelao, abracadeiras, suportes, roldanas e materiais de instalacao.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Materiais separados dos ativos reutilizaveis.\par

\pard\sb220\sa140\f1\fs27\cf1\b 4. Ferramentas\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Alicates, chaves, macaricos e maquina de fusao.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Controle de patrimonio, serie, estado e responsavel.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Edicao e arquivamento disponiveis para Desenvolvedor/Admin.\par

\pard\sb220\sa140\f1\fs27\cf1\b 5. EPIs\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Capacete, oculos, luvas, botina e colete refletivo.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Cinturao, talabarte e capa de chuva.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Controle de unidade, quantidade, estado e tecnico responsavel.\par

\pard\sb220\sa140\f1\fs27\cf1\b 6. Ativos de campo\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Equipamentos reutilizaveis, roteadores e itens patrimoniais.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Numero de serie, fabricante, modelo e estado de conservacao.\par
\pard\li360\sa120\fs20\cf1\bullet\tab A tela substitui o nome generico Equipamentos por Ativos de campo.\par

\pard\sb220\sa140\f1\fs27\cf1\b 7. Equipamentos de seguranca e sinalizacao\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Escada, cone, cavalete, fita zebrada e placa de sinalizacao.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Corrente de isolamento.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Unidade, saldo, movimentacao para tecnico, edicao e arquivamento.\par

\pard\sb220\sa140\f1\fs27\cf1\b 8. Tecnicos e Caixa do tecnico\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Tecnicos cadastrados: Kaique, Mateus, Walison, Valdenilson, Gleidson Terceirizado, Wanderson, Bruno e Cleidson.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Caixa do tecnico mostra materiais, ferramentas, EPIs e ativos sob responsabilidade.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Historico individual de recebimentos e movimentacoes.\par

\pard\sb220\sa140\f1\fs27\cf1\b 9. Movimentacoes\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Entradas, saidas, transferencias, devolucoes e ajustes.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Pesquisa de saldo por material.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Historico com data, hora, item, quantidade, destino, usuario e motivo.\par

\pard\sb220\sa140\f1\fs27\cf1\b 10. Inventario\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Conferencia de um material por vez.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Indicadores de conferidos, pendentes e divergentes.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Diferencas geram ajustes rastreaveis no historico.\par

\pard\sb220\sa140\f1\fs27\cf1\b 11. Relatorios e PDF\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab PDF com marca Uay Internet, cabecalho azul e faixa amarela.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Resumo de entradas, saidas, ajustes e total de unidades UN.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Itens movimentados para tecnicos.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Tabela organizada com data, tipo, item, quantidade, unidade, destino e motivo.\par

\pard\sb220\sa140\f1\fs27\cf1\b 12. Perfis de acesso\b0\par
\pard\li360\sa80\fs20\cf1\bullet\tab Desenvolvedor: acesso total, edicao e arquivamento.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Almoxarifado: entradas, saidas, devolucoes, inventario e relatorios.\par
\pard\li360\sa80\fs20\cf1\bullet\tab Donos e Gestao: fiscalizacao, consultas, indicadores e relatorios.\par
\pard\li360\sa120\fs20\cf1\bullet\tab Tecnico: acesso limitado aos itens sob sua responsabilidade.\par

\pard\sb300\sa160\f1\fs28\cf1\b Fluxo principal\b0\par
\pard\qc\sb120\sa120\fs21\cf2\b Fornecedor  ->  Almoxarifado  ->  Tecnico  ->  Uso em campo  ->  Devolucao/Baixa\b0\par
